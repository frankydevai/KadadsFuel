# Private values are deliberately blank. Copy to .env and configure locally.
# Never commit .env, real credentials, driver rosters, or group identifiers.
COMPANY_NAME=Kadads
BOT_MODE=active

# Preserve the current three-truck trial. Empty TEST_TRUCK_UNITS means full fleet.
TEST_TRUCK_UNITS=6682,8089,8217
AUTO_LINK_ENABLED=false
TELEGRAM_MESSAGING_MODE=silent
RUN_SCHEMA_ON_STARTUP=false

TMS_PROVIDER=quickmanage
QUICKMANAGE_BASE_URL=https://api.quickmanage.com
QUICKMANAGE_CLIENT_ID=
QUICKMANAGE_CLIENT_SECRET=
SAMSARA_API_TOKEN=
DATABASE_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Optional; leave unset during the restricted driver-only trial.
# TELEGRAM_DISPATCH_CHAT_ID=

# Exact private supplier/account identities from the carrier's actual files.
PILOT_ACCOUNT_NUMBER=
FTS_PRICE_CUSTOMER=
LOVES_PRICE_CUSTOMER=
MAX_FUEL_PRICE_AGE_DAYS=3

# Active bot routing requires the private authenticated Valhalla server.
VALHALLA_URL=
VALHALLA_API_SECRET=
VALHALLA_TIMEOUT_SECONDS=15
VALHALLA_MAX_MATRIX_LOCATIONS=48

# Dashboard service: set BOT_MODE=bootstrap and configure these private values.
DASHBOARD_SECRET=
DASHBOARD_ADMIN_EMAIL=
DASHBOARD_ADMIN_PASSWORD=
DASHBOARD_COOKIE_SECURE=true

# Model defaults; confirm tank size and operating economics for the carrier.
IFTA_HOME_STATE=NJ
FLEET_DEFAULT_MPG=6.5
TANK_CAPACITY_GALLONS=200
SAFETY_FLOOR_GALLONS=30
MAX_ARRIVAL_FUEL_GALLONS=80
DELIVERY_RESERVE_PCT=30
RANK_STRATEGY=your_price
COST_PER_MILE=0.55
STOP_TIME_PENALTY=20
MIN_FUEL_PURCHASE_GALLONS=50
BRIDGE_MIN_FUEL_PURCHASE_GALLONS=90
MAX_STOP_DETOUR_MILES=10
MAX_ADVICE_GPS_AGE_MINUTES=5
MAX_ADVICE_FUEL_AGE_MINUTES=30
LOAD_SYNC_ORDER_ENUMERATION_TIMEOUT_SECONDS=600
DRIVER_REST_SPEED_MPH=2
DRIVER_REST_MINUTES=60
